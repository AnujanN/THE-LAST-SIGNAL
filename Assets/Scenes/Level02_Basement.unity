    text: Water everywhere. The power down here is dead too.
    seconds: 3
  - speaker: ALEX
    text: There has to be a generator. Maybe an elevator up to the tower.
    seconds: 3.5
  flashlightDrain: 1
  drainPerSecond: 0.55
  ambience: 3
  ambienceVolume: 0.65
