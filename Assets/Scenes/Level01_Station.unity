  m_Name: 
  m_EditorClassIdentifier: LastSignal.Runtime::LastSignal.Interaction.NoteInteractable
  id: l1_memo
  title: Station manager's memo
  body: 'To all staff:


    The experimental broadcast rig in the tower stays OFF during storms. Lightning took out the old mast last year and the rig nearly caught fire.


    And please stop letting the kids play with the transmitter.


    - R.'
  onRead:
    m_PersistentCalls:
      m_Calls: []
