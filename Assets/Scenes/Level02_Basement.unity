  m_Name: 
  m_EditorClassIdentifier: LastSignal.Runtime::LastSignal.Interaction.NoteInteractable
  id: l2_maintenance
  title: Generator maintenance card (torn)
  body: "BACKUP GENERATOR - COLD START\n\nFit all parts first: spark plug, 30A fuse, drive belt.\n\n1. Open the FUEL VALVE (red).\n2. PRIME her until the pressure needle sits in the GREEN.\n    Not past it - she floods, and she stalls LOUD.\n3. ..........\n\n[The rest of the card has been torn away.]"
  onRead:
    m_PersistentCalls:
      m_Calls: []
