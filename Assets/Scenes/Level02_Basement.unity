  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 66934cf8d2aa7b5478fb4b6a9e2254e8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LastSignal.Runtime::LastSignal.Interaction.TapePlayer
  id: l2_tape
  deviceName: emergency recorder
  requiredItemId: 
  requiredCount: 1
  missingItemMessage: There is no tape in it.
  requiredFlag: power:generator
  missingFlagMessage: It needs power. The generator is down.
  lockPlayer: 0
  replayable: 1
  lines:
  - speaker: RECORDING
    text: '[Emergency log. Alarms. Rain against the windows.]'
    seconds: 2.5
  - speaker: MAYA (TAPE)
    text: Lightning hit the mast. The broadcast rig caught fire and the signal won't stop.
    seconds: 5
  - speaker: MAYA (TAPE)
    text: The smoke's so thick. I can't see Alex anywhere.
    seconds: 4
  - speaker: MAYA (TAPE)
    text: I'm trapped near the broadcasting room. The fire's between me and the stairs.
    seconds: 5
  - speaker: MAYA (TAPE)
    text: 'If the signal won''t stop, the emergency shutdown only works on Dad''s channel. One-oh-three point- [static]'
    seconds: 6
  - speaker: RECORDING
    text: '[The recording ends.]'
    seconds: 2
  onStarted:
    m_PersistentCalls:
      m_Calls: []
  onFinished:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 924393703}
        m_TargetAssemblyTypeName: LastSignal.GameFlow.StoryEvents, LastSignal.Runtime
        m_MethodName: SetObjective
        m_Mode: 5
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: 
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: l2_lift|Take the elevator up towards the transmission tower
          m_BoolArgument: 0
        m_CallState: 2
      - m_Target: {fileID: 924393703}
        m_TargetAssemblyTypeName: LastSignal.GameFlow.StoryEvents, LastSignal.Runtime
        m_MethodName: AddClue
        m_Mode: 5
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: 
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 'Basement tape: the emergency shutdown channel is one-oh-three point... (lost in static)'
          m_BoolArgument: 0
        m_CallState: 2
      - m_Target: {fileID: 924393703}
        m_TargetAssemblyTypeName: LastSignal.GameFlow.StoryEvents, LastSignal.Runtime
        m_MethodName: Say
        m_Mode: 5
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: 
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: ALEX|103.7. Dad's old frequency. I need to get up to the tower.|4
          m_BoolArgument: 0
        m_CallState: 2
