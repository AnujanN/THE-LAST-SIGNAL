  m_Name: 
  m_EditorClassIdentifier: LastSignal.Runtime::LastSignal.Interaction.NoteInteractable
  id: l1_circuits
  title: Circuit diagram (manager's office)
  body: 'MAIN PANEL - SERVICE CORRIDOR


    B1  Corridor and room lights

    B2  Control room door lock

    B3  Roof antenna (tower mast)

    B4  Heating

    B5  Broadcast rig (tower)

    B6  Tower lift motor


    Maya - stop switching the rig back on. I mean it.

    - Dad'
  onRead:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1536205095}
