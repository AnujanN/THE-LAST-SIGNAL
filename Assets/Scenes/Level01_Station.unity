  m_Name: 
  m_EditorClassIdentifier: LastSignal.Runtime::LastSignal.Interaction.NoteInteractable
  id: l1_circuits
  title: Circuit diagram (manager's office)
  body: 'MAIN PANEL - SERVICE CORRIDOR


    B1  Corridor and room lights

    B2  Control room door lock

    B3  Roof antenna (tower mast)

    B4  Heating

    B5  Broadcast rig (tower)

    B6  Tower lift motor


    Maya - stop switching the rig back on. I mean it.

    - Dad'
  onRead:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1467825918}
        m_TargetAssemblyTypeName: LastSignal.GameFlow.StoryEvents, LastSignal.Runtime
        m_MethodName: AddClue
        m_Mode: 5
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: 
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 'Circuits: B1 lights, B2 door lock, B3 antenna (tower), B4 heating, B5 rig (tower), B6 lift (tower).'
          m_BoolArgument: 0
        m_CallState: 2
