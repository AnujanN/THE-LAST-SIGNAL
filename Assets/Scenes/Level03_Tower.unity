  m_Name: 
  m_EditorClassIdentifier: LastSignal.Runtime::LastSignal.Interaction.NoteInteractable
  id: l3_notebook
  title: Maya's notebook
  body: 'Dad always said: if you''re ever lost, find 103.7 and you''ll find your way home.


    Tonight I heard myself on 103.7. Talking. Asking Alex to stay.


    That wasn''t me.'
  onRead:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1405333821}
        m_TargetAssemblyTypeName: LastSignal.GameFlow.StoryEvents, LastSignal.Runtime
        m_MethodName: Say
        m_Mode: 5
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: 
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: ALEX|103.7. Same as the tape. Same as Dad's old station.|4
          m_BoolArgument: 0
        m_CallState: 2
