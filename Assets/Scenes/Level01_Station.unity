  m_Name: 
  m_EditorClassIdentifier: LastSignal.Runtime::LastSignal.Interaction.NoteInteractable
  id: l1_maya_note
  title: Note in Maya's handwriting
  body: 'Alex,


    The transmitter keeps talking back. It knows our names.


    I put the spare basement key in the control desk. If anything goes wrong tonight, DON''T come looking for me downstairs. Just go home.


    - M'
  onRead:
    m_PersistentCalls:
      m_Calls: []
