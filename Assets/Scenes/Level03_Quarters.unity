--- !u!114 &1410908072
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1410908070}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4e51596caa14b0a4bb7e935560de9c51, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LastSignal.Runtime::LastSignal.Interaction.NoteInteractable
  id: l3q_diary
  title: Maya's diary
  body: 'Oct 3

    The rig talks back now. Not words at first. Breathing. Then my name.


    Oct 9

    It said Alex''s name before Alex did. It''s learning us. Dad switched it off and it STILL whispered.


    Oct 12

    Dad says every good station ends on a seven. His was one-oh-three-POINT-SEVEN. If I talk to it on Dad''s channel during the storm test, maybe I can tell it to leave us alone.'
  onRead:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 393551991}
        m_TargetAssemblyTypeName: LastSignal.GameFlow.StoryEvents, LastSignal.Runtime
        m_MethodName: AddClue
        m_Mode: 5
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: 
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 'Maya''s diary: Dad''s channel always ended on seven - point seven.'
          m_BoolArgument: 0
        m_CallState: 2
      - m_Target: {fileID: 393551991}
        m_TargetAssemblyTypeName: LastSignal.GameFlow.StoryEvents, LastSignal.Runtime
        m_MethodName: Say
        m_Mode: 5
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: 
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: ALEX|Point seven. The tape said one-oh-three... Dad's channel was 103.7.|4.5
          m_BoolArgument: 0
        m_CallState: 2
