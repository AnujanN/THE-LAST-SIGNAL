  m_Script: {fileID: 11500000, guid: 4e51596caa14b0a4bb7e935560de9c51, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LastSignal.Runtime::LastSignal.Interaction.NoteInteractable
  id: l3_notebook
  title: Maya's notebook
  body: 'Dad always said: if you''re ever lost, find his channel and you''ll find your way home.


    Tonight I heard myself on it. Talking. Asking Alex to stay.


    That wasn''t me.'
  onRead:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 993123147}
        m_TargetAssemblyTypeName: LastSignal.GameFlow.StoryEvents, LastSignal.Runtime
        m_MethodName: Say
        m_Mode: 5
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: 
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: ALEX|Dad's channel. One-oh-three from the basement tape... and he always ended on seven.|5
          m_BoolArgument: 0
        m_CallState: 2
      - m_Target: {fileID: 993123147}
        m_TargetAssemblyTypeName: LastSignal.GameFlow.StoryEvents, LastSignal.Runtime
        m_MethodName: AddClue
        m_Mode: 5
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: 
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: Dad's channel is the emergency channel (one-oh-three... point seven?)
          m_BoolArgument: 0
        m_CallState: 2
