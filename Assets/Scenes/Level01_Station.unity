MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 223820791}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 66934cf8d2aa7b5478fb4b6a9e2254e8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LastSignal.Runtime::LastSignal.Interaction.TapePlayer
  id: l1_tape
  deviceName: tape player
  requiredItemId: tape_fragment
  requiredCount: 3
  missingItemMessage: The tape is incomplete. Find all three fragments.
  requiredFlag: power:station
  missingFlagMessage: It has no power.
  lockPlayer: 0
  replayable: 1
  lines:
  - speaker: RECORDING
    text: '[Static. Rain on a microphone.]'
    seconds: 2.5
  - speaker: MAYA (TAPE)
    text: Test, test... It's the night of the storm. Alex is here with me at the station.
    seconds: 5
  - speaker: MAYA (TAPE)
    text: Dad's old transmitter is acting strange. The needles keep jumping, even with the power low.
    seconds: 5
  - speaker: MAYA (TAPE)
    text: There's a voice under the static. It sounds like... me. That isn't possible.
    seconds: 5
  - speaker: MAYA (TAPE)
    text: The spare key to the basement is in the control desk. Alex, whatever happens, don't-
    seconds: 5
  - speaker: RECORDING
    text: '[The tape cuts to static.]'
    seconds: 2.5
  onStarted:
    m_PersistentCalls:
      m_Calls: []
  onFinished:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 588857389}
        m_TargetAssemblyTypeName: LastSignal.GameFlow.StoryEvents, LastSignal.Runtime
        m_MethodName: SetObjective
        m_Mode: 5
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: 
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: l1_key|Find the basement key in the control room
          m_BoolArgument: 0
        m_CallState: 2
      - m_Target: {fileID: 588857389}
        m_TargetAssemblyTypeName: LastSignal.GameFlow.StoryEvents, LastSignal.Runtime
        m_MethodName: Say
        m_Mode: 5
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: 
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: ALEX|Don't what, Maya?|2.5
          m_BoolArgument: 0
        m_CallState: 2
