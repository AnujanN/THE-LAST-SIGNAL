  m_Name: 
  m_EditorClassIdentifier: LastSignal.Runtime::LastSignal.GameFlow.EndingSequence
  cameraRig: {fileID: 1626886742}
  cameraStart: {fileID: 1338301964}
  cameraEnd: {fileID: 162105453}
  dollySeconds: 24
  lines:
  - speaker: 
    text: Three months later.
    seconds: 3.5
  - speaker: ALEX
    text: I listened to the whole tape again, Maya. Every word.
    seconds: 4.5
  - speaker: ALEX
    text: You got me out. You stayed. And I'm done blaming myself - I promised you I'd live.
    seconds: 6
  - speaker: 
    text: '[Alex sets the old cassette beside the memorial.]'
    seconds: 3.5
  - speaker: ALEX
    text: I heard you this time, Maya. Goodbye.
    seconds: 5
  theEnd: {fileID: 228438188}
  credits: {fileID: 950911233}
  creditsSpeed: 80
  creditsEndY: 1700
  menuButton: {fileID: 1843076045}
