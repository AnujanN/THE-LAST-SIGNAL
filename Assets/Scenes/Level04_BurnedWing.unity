MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2034291830}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 66934cf8d2aa7b5478fb4b6a9e2254e8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LastSignal.Runtime::LastSignal.Interaction.TapePlayer
  id: l4_recorder
  deviceName: scorched recorder
  requiredItemId: 
  requiredCount: 1
  missingItemMessage: There is no tape in it.
  requiredFlag: 
  missingFlagMessage: It has no power.
  lockPlayer: 0
  replayable: 1
  lines:
  - speaker: RECORDING
    text: '[Crackling flames. Someone coughing right against the microphone.]'
    seconds: 3
  - speaker: MAYA (SCORCHED TAPE)
    text: Alex! The emergency exit - go! I'm right behind you!
    seconds: 4
  - speaker: MAYA (SCORCHED TAPE)
    text: ...he's out. He's out. Okay. Okay.
    seconds: 3.5
  - speaker: MAYA (SCORCHED TAPE)
    text: The rig is still transmitting. If I leave now it keeps calling... it'll call him back here.
    seconds: 5.5
  - speaker: MAYA (SCORCHED TAPE)
    text: I'm going up to the tower to finish it. I'll record everything. Alex, don't come looking for-
    seconds: 5.5
  - speaker: RECORDING
    text: '[The tape warps into silence.]'
    seconds: 2.5
  onFinished:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 116081437}
        m_TargetAssemblyTypeName: LastSignal.GameFlow.StoryEvents, LastSignal.Runtime
        m_MethodName: Say
        m_Mode: 5
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: 
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: ALEX|She went up. Alone. For me.|3
          m_BoolArgument: 0
        m_CallState: 2
      - m_Target: {fileID: 116081437}
        m_TargetAssemblyTypeName: LastSignal.GameFlow.StoryEvents, LastSignal.Runtime
        m_MethodName: AddClue
        m_Mode: 5
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: 
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 'Maya''s scorched tape: she got Alex out, then went up to the tower to stop the signal.'
          m_BoolArgument: 0
        m_CallState: 2
