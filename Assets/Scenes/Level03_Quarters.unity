  m_Script: {fileID: 11500000, guid: 4e51596caa14b0a4bb7e935560de9c51, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LastSignal.Runtime::LastSignal.Interaction.NoteInteractable
  id: l3q_logbook
  title: Dad's logbook
  body: 'Oct 2 - Interference on the experimental rig again. A voice under the carrier. It copies the kids.


    Oct 13 - Storm due tomorrow night. Told Maya: NO broadcast test. Rig stays off.


    Nov 3 - Came back for her things. Locked the key to the broadcast wing in my safe. Nobody goes in there again.

    The combination is the night everything ended. Month first, the way the tower clock showed it.'
  onRead:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 2144201116}
        m_TargetAssemblyTypeName: LastSignal.GameFlow.StoryEvents, LastSignal.Runtime
        m_MethodName: AddClue
        m_Mode: 5
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: 
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 'Dad''s safe: the night everything ended, month first (MM DD).'
          m_BoolArgument: 0
        m_CallState: 2
      - m_Target: {fileID: 2144201116}
        m_TargetAssemblyTypeName: LastSignal.GameFlow.StoryEvents, LastSignal.Runtime
        m_MethodName: SetObjectiveIfNotFlag
        m_Mode: 5
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: 
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: code:l3q_safe|l3q_safe|Open Dad's safe in the study. The combination is a date.
          m_BoolArgument: 0
        m_CallState: 2
