  firstCall:
  - speaker: 
    text: '[The radio clicks on by itself. Static.]'
    seconds: 3
  - speaker: MAYA (RADIO)
    text: Alex... can you hear me?
    seconds: 3.5
  - speaker: ALEX
    text: Maya?
    seconds: 2.5
  secondCall:
  - speaker: MAYA (RADIO)
    text: I'm scared, Alex. You have to come back.
    seconds: 4
  atTheRadio:
  - speaker: ALEX
    text: No... this can't be happening. You're...
    seconds: 3.5
  - speaker: MAYA (RADIO)
    text: Northpoint... the station... please...
    seconds: 3.5
  - speaker: MAYA (RADIO)
    text: ...before it finds me.
    seconds: 3
  afterPhoto:
  - speaker: ALEX
    text: Ten years. I left you there, Maya.
    seconds: 3.5
  - speaker: ALEX
    text: Whatever that was... I'm going back.
    seconds: 3.5
