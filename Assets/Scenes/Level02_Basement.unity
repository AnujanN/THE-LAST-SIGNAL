  m_Name: 
  m_EditorClassIdentifier: LastSignal.Runtime::LastSignal.Interaction.NoteInteractable
  id: l2_maintenance
  title: Generator maintenance card
  body: "BACKUP GENERATOR - COLD START\n\nCheck all parts are fitted:\n  - spark plug   - 30A fuse   - drive belt\n\nThen, IN THIS ORDER:\n  1. FUEL VALVE   (red)\n  2. CHOKE        (yellow)\n  3. STARTER      (green)\n\nWrong order floods the engine. If it stalls, start again from step 1."
  onRead:
    m_PersistentCalls:
      m_Calls: []
