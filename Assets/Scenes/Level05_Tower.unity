MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1945411580}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 66934cf8d2aa7b5478fb4b6a9e2254e8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LastSignal.Runtime::LastSignal.Interaction.TapePlayer
  id: l3_final
  deviceName: Maya's final recording
  requiredItemId: 
  requiredCount: 1
  missingItemMessage: There is no tape in it.
  requiredFlag: puzzle:l3_frequency
  missingFlagMessage: Only static. The broadcast isn't running.
  lockPlayer: 1
  replayable: 0
  lines:
  - speaker: RECORDING
    text: '[The broadcast clears. Maya''s voice, close to the microphone.]'
    seconds: 3
  - speaker: MAYA (FINAL RECORDING)
    text: Alex, if you're hearing this, you got out. I pushed you through the emergency exit.
    seconds: 5.5
  - speaker: MAYA (FINAL RECORDING)
    text: You didn't leave me behind. I stayed. The transmitter was overloading, and if the signal spread, it would keep calling people here.
    seconds: 7
  - speaker: MAYA (FINAL RECORDING)
    text: Something lives in the static. It copies voices. It will use mine. Don't believe it.
    seconds: 5.5
  - speaker: MAYA (FINAL RECORDING)
    text: This was never your fault. Please stop blaming yourself. Live, for both of us.
    seconds: 6
  - speaker: MAYA (FINAL RECORDING)
    text: I love you, big brother. Now shut it down... and go home.
    seconds: 5
  - speaker: RECORDING
    text: '[The recording ends.]'
    seconds: 2
  onFinished:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 297601573}
        m_TargetAssemblyTypeName: LastSignal.GameFlow.StoryEvents, LastSignal.Runtime
        m_MethodName: Say
        m_Mode: 5
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: 
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: ALEX|You saved me. All this time... I'm sorry, Maya. I hear you.|4.5
          m_BoolArgument: 0
        m_CallState: 2
      - m_Target: {fileID: 297601573}
        m_TargetAssemblyTypeName: LastSignal.GameFlow.StoryEvents, LastSignal.Runtime
        m_MethodName: SetObjective
        m_Mode: 5
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: 
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: l3_shutdown|Pull the master shutdown lever
          m_BoolArgument: 0
        m_CallState: 2
