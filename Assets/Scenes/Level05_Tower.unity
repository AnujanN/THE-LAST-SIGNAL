  - speaker: ALEX
    text: The stairs end here. The transmission tower. This is where it all started.
    seconds: 4
  - speaker: THE ECHO (MAYA'S VOICE)
    text: Alex... why won't you stay?
    seconds: 3
  flashlightDrain: 1
  drainPerSecond: 0.8
  ambience: 4
  ambienceVolume: 0.55
