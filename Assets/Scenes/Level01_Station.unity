          m_ObjectArgumentAssemblyTypeName: 
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 'Circuits: B1 lights, B2 door lock, B3 antenna (tower), B4 heating, B5 rig (tower), B6 lift (tower).'
          m_BoolArgument: 0
        m_CallState: 2
  paperStyle: 5
  ink: {r: 0.12, g: 0.12, b: 0.13, a: 1}
  canHold: 0
  heldMaterial: {fileID: 0}
  writing: {fileID: 0}
