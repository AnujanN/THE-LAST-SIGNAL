  m_Script: {fileID: 11500000, guid: 4e51596caa14b0a4bb7e935560de9c51, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LastSignal.Runtime::LastSignal.Interaction.NoteInteractable
  id: l1_wiring
  title: Wiring memo (taped to the fuse box)
  body: 'IF THE MAIN TRIPS AGAIN:


    B1  Lights ............. UP

    B2  Old transmitter ...... DOWN (never up in a storm!)

    B3  Heating ............ UP

    B4  Roof antenna ....... DOWN


    Insert the main fuse first, then pull the main lever.


    Maya - please don''t touch B2 again.'
  onRead:
    m_PersistentCalls:
      m_Calls: []
