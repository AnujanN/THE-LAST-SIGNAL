  m_Name: 
  m_EditorClassIdentifier: LastSignal.Runtime::LastSignal.Interaction.NoteInteractable
  id: l1_visitor_log
  title: Visitor log
  body: 'STORM NIGHT - 14 OCTOBER


    23:10  IN   Maya R. (staff family)

    23:10  IN   Alex R. (staff family)

    02:47  OUT  Alex R.

    --:--  OUT  Maya R.  ________


    The last line was never signed.'
  onRead:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1467825918}
        m_TargetAssemblyTypeName: LastSignal.GameFlow.StoryEvents, LastSignal.Runtime
        m_MethodName: AddClue
        m_Mode: 5
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: 
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 'Storm night (14 Oct): Alex signed out at 02:47. Maya never signed out.'
          m_BoolArgument: 0
        m_CallState: 2
