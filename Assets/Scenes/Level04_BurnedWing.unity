  m_Name: 
  m_EditorClassIdentifier: LastSignal.Runtime::LastSignal.Interaction.NoteInteractable
  id: l4_schematic
  title: Junction J-4 schematic
  body: 'EMERGENCY JUNCTION J-4


    FEED A -> line 1 or 2

    FEED B -> line 2 or 3

    FEED C -> line 1 or 3


    LINE 1: through Studio A

    LINE 2: through the west office ceiling

    LINE 3: along the east wall to the stairwell


    LOAD: STUDIO / RIG / LIFT (stair door maglock + tower lift)'
  onRead:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1645167566}
        m_TargetAssemblyTypeName: LastSignal.GameFlow.StoryEvents, LastSignal.Runtime
        m_MethodName: AddClue
        m_Mode: 5
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: 
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 'Junction J-4: A->1/2, B->2/3, C->1/3. Line 1 Studio A, line 2 west office, line 3 east wall. LIFT powers the stairs.'
          m_BoolArgument: 0
        m_CallState: 2
