  m_Name: 
  m_EditorClassIdentifier: LastSignal.Runtime::LastSignal.Interaction.NoteInteractable
  id: l3q_photo
  title: Family photo
  body: 'A faded photo on the wall: Dad, Maya and Alex in front of the tower, squinting into the sun.


    On the back, in Maya''s handwriting: ''Our station. Our home. Whatever happens, we find each other.'''
  onRead:
    m_PersistentCalls:
      m_Calls: []
